    {
      "key": "show_notification",
      "label": {
        "en": "Show on the LaMetric",
        "fr": "Afficher sur la LaMetric",
        "de": "Auf der LaMetric anzeigen",
        "es": "Mostrar en la LaMetric"
      },
      "description": {
        "en": "Shows a text on one clock or on all, with an icon, a sound and a priority.",
        "fr": "Affiche un texte sur une horloge ou sur toutes, avec une icône, un son et une priorité.",
        "de": "Zeigt einen Text auf einer oder allen Uhren an, mit Symbol, Ton und Priorität.",
        "es": "Muestra un texto en un reloj o en todos, con un icono, un sonido y una prioridad."
      },
