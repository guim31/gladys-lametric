{
  "manifest_version": 1,
  "type": "device",
  "name": "LaMetric",
  "description": {
    "en": "LaMetric TIME and SKY clocks: messages from your scenes, brightness, volume, apps and timer.",
    "fr": "Horloges LaMetric TIME et SKY : messages de vos scènes, luminosité, volume, applications, minuteur.",
    "de": "LaMetric TIME und SKY: Nachrichten aus Szenen, Helligkeit, Lautstärke, Apps und Timer.",
    "es": "Relojes LaMetric TIME y SKY: mensajes de sus escenas, brillo, volumen, aplicaciones y temporizador."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-lametric:1.0.1",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-lametric/main/cover.png",
  "categories": ["notifications", "multimedia"],
  "transports": ["local"],
  "network_discovery": [
    {
      "type": "ssdp",
      "st": "urn:schemas-upnp-org:device:LaMetric:1"
    }
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your LaMetric",
        "fr": "Votre LaMetric",
        "de": "Deine LaMetric",
        "es": "Su LaMetric"
      },
      "description": {
        "en": "LaMetric TIME or SKY on your local network, up to three. Each clock has its own API key: sign in on developer.lametric.com, open Devices and copy the key of the clock.",
        "fr": "LaMetric TIME ou SKY de votre réseau local, jusqu’à trois. Chaque horloge a sa clé d’API : connectez-vous sur developer.lametric.com, ouvrez Devices et copiez la clé de l’horloge.",
        "de": "LaMetric TIME oder SKY in deinem lokalen Netzwerk, bis zu drei. Jede Uhr hat ihren API-Schlüssel: Melde dich auf developer.lametric.com an, öffne Devices und kopiere den Schlüssel der Uhr.",
        "es": "LaMetric TIME o SKY de su red local, hasta tres. Cada reloj tiene su clave de API: inicie sesión en developer.lametric.com, abra Devices y copie la clave del reloj."
      },
      "links": [
        {
          "url": "https://developer.lametric.com/user/devices",
          "label": {
            "en": "My devices on developer.lametric.com",
            "fr": "Mes appareils sur developer.lametric.com",
            "de": "Meine Geräte auf developer.lametric.com",
            "es": "Mis dispositivos en developer.lametric.com"
          }
        },
        {
          "url": "https://github.com/guim31/gladys-lametric/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d’installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "clock_1_address",
      "type": "string",
      "label": {
        "en": "Address",
        "fr": "Adresse",
        "de": "Adresse",
        "es": "Dirección"
      },
      "description": {
        "en": "IP address of the clock. Empty: Gladys looks for it on the network.",
        "fr": "Adresse IP de l’horloge. Vide : Gladys la cherche sur le réseau.",
        "de": "IP-Adresse der Uhr. Leer: Gladys sucht sie im Netzwerk.",
        "es": "Dirección IP del reloj. Vacío: Gladys lo busca en la red."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.20",
        "fr": "ex. 192.168.1.20",
        "de": "z. B. 192.168.1.20",
        "es": "p. ej. 192.168.1.20"
      },
      "required": false
    },
    {
      "key": "clock_1_api_key",
      "type": "secret",
      "label": {
        "en": "API key",
        "fr": "Clé d’API",
        "de": "API-Schlüssel",
        "es": "Clave de API"
      },
      "description": {
        "en": "The API key of this clock: developer.lametric.com, Devices.",
        "fr": "La clé d’API de cette horloge : developer.lametric.com, Devices.",
        "de": "Der API-Schlüssel dieser Uhr: developer.lametric.com, Devices.",
        "es": "La clave de API de este reloj: developer.lametric.com, Devices."
